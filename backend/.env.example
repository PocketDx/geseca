# Copiar a .env  ->  cp .env.example .env
# Generar una clave:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-insecure-cambiar-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origen del frontend Next.js. Necesario para el chequeo CSRF de Django,
# porque el navegador llega a Django a traves del rewrite de Next.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SQLite por defecto. Para PostgreSQL:
# DATABASE_URL=postgres://usuario:clave@localhost:5432/smartwash

# Correo (recuperacion de contrasena). Por defecto se imprime en la consola.
# Para enviar por SMTP (ej. Gmail con contrasena de aplicacion):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=cuenta@gmail.com
# EMAIL_HOST_PASSWORD=contrasena-de-aplicacion
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=SmartWash <cuenta@gmail.com>
